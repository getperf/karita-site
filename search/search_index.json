{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u30db\u30fc\u30e0","text":""},{"location":"#karita","title":"karita","text":"<p>karita \u306f\u3001\u8907\u6570\u306e\u56f3\u66f8\u9928\u306e\u8cb8\u51fa\u3057\u8a18\u9332\u3092\u307e\u3068\u3081\u3066\u7ba1\u7406\u3059\u308b\u30a2\u30d7\u30ea\u3067\u3059\uff08Windows / Android \u5bfe\u5fdc\uff09\u3002</p> <ol> <li>Web \u30d6\u30e9\u30a6\u30b6\u3067\u30ab\u30fc\u30ea\u30eb\u306e\u30b5\u30a4\u30c8\u304b\u3089\u56f3\u66f8\u3092\u691c\u7d22\u3057\u3001\u56f3\u66f8\u9928\u30b5\u30a4\u30c8\u3067\u8cb8\u51fa\u3057\u306e\u624b\u7d9a\u304d\u3092\u884c\u3046</li> <li>\u305d\u306e\u7d50\u679c\u3092\u3001\u30d6\u30e9\u30a6\u30b6\u62e1\u5f35\u300ckarita \u306b\u9001\u308b\u300d\u3067 karita \u3078\u9001\u308b</li> <li>karita \u304c\u305d\u306e\u8cb8\u51fa\u3057\u8a18\u9332\u3092\u7ba1\u7406\u3057\u3001\u5404\u56f3\u66f8\u9928\u306e\u4e88\u7d04\u72b6\u6cc1\u30fb\u8cb8\u51fa\u3057\u72b6\u6cc1\u3092\u307e\u3068\u3081\u3066\u78ba\u8a8d\u3067\u304d\u308b</li> <li>\u8aad\u307f\u7d42\u3048\u305f\u56f3\u66f8\u306f\u30ec\u30d3\u30e5\u30fc\u3092\u8a18\u9332\u3057\u3001\u8aad\u66f8\u5c65\u6b74\u3068\u3057\u3066\u7ba1\u7406\u3059\u308b</li> </ol> <p>\u66f8\u8a8c\u60c5\u5831\u306f\u30ab\u30fc\u30ea\u30eb\u30fbopenBD \u3078\u7aef\u672b\u304b\u3089\u76f4\u63a5\u554f\u3044\u5408\u308f\u305b\u3001\u8535\u66f8\u30c7\u30fc\u30bf\u306f\u5229\u7528\u8005\u81ea\u8eab\u306e Google Drive \uff08\u30a2\u30d7\u30ea\u5c02\u7528\u9818\u57df\uff09\u3092\u4ecb\u3057\u3066\u7aef\u672b\u9593\u3067\u540c\u671f\u3057\u307e\u3059\u3002\u958b\u767a\u8005\u72ec\u81ea\u306e\u30b5\u30fc\u30d0\u30fc\u306f\u6301\u3061\u307e\u305b\u3093\u3002</p> <p>\u30d6\u30e9\u30a6\u30b6\u62e1\u5f35\u300ckarita \u306b\u9001\u308b\u300d\uff08Chrome / Edge / Firefox\uff09\u306f\u3001\u30ab\u30fc\u30ea\u30eb\u306e\u66f8\u7c4d\u30da\u30fc\u30b8\u306e URL \u3092 karita \u30a2\u30d7\u30ea\u3078\u9001\u308b\u305f\u3081\u306e\u5c0f\u3055\u306a\u6a4b\u6e21\u3057\u3067\u3059\u3002</p> <ul> <li>\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u30dd\u30ea\u30b7\u30fc</li> <li>\u5229\u7528\u898f\u7d04</li> </ul> <p>\u00a9 2026 getperf.net</p>"},{"location":"privacy/","title":"\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u30dd\u30ea\u30b7\u30fc","text":"<p>\u30a2\u30d7\u30ea\u540d: karita \u958b\u767a\u8005: \u53e4\u6fa4 \u5b9f \u30b5\u30dd\u30fc\u30c8\u9023\u7d61\u5148: furu3@getperf.net \u30c9\u30e1\u30a4\u30f3: https://karita.getperf.net \u516c\u958b\u65e5: 2026\u5e749\u670826\u65e5 \u6700\u7d42\u6539\u5b9a\u65e5: 2026\u5e749\u670826\u65e5</p>"},{"location":"privacy/#1","title":"1. \u5bfe\u8c61\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2","text":"<p>\u672c\u30dd\u30ea\u30b7\u30fc\u306f\u4ee5\u4e0b\u306e\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u3092\u5bfe\u8c61\u3068\u3057\u307e\u3059\u3002</p> <ul> <li>karita \u30a2\u30d7\u30ea\uff08Windows / Android\uff09</li> <li>\u30d6\u30e9\u30a6\u30b6\u62e1\u5f35\u6a5f\u80fd\u300ckarita \u306b\u9001\u308b\u300d\uff08Chrome / Edge\uff09</li> </ul> <p>\u3053\u308c\u3089\u306f\u3044\u305a\u308c\u3082\u5229\u7528\u8005\u306e\u7aef\u672b\u4e0a\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002\u958b\u767a\u8005\u306f\u72ec\u81ea\u306e\u30b5\u30fc\u30d0\u30fc\u3092\u6301\u305f\u305a\u3001 \u30a2\u30d7\u30ea\u304c\u6271\u3046\u30c7\u30fc\u30bf\u3092\u958b\u767a\u8005\u5074\u3067\u53ce\u96c6\u30fb\u4fdd\u5b58\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>"},{"location":"privacy/#2","title":"2. \u53d6\u5f97\u3059\u308b\u60c5\u5831","text":""},{"location":"privacy/#2-1-google","title":"2-1. Google \u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u901a\u3058\u3066\u53d6\u5f97\u3059\u308b\u60c5\u5831\uff08\u540c\u671f\u6a5f\u80fd\uff09","text":"<p>karita \u306f\u30c7\u30fc\u30bf\u306e\u7aef\u672b\u9593\u540c\u671f\u306b\u3001\u5229\u7528\u8005\u81ea\u8eab\u306e Google \u30a2\u30ab\u30a6\u30f3\u30c8\u306e Google Drive \u30a2\u30d7\u30ea\u5c02\u7528\u9818\u57df\uff08<code>drive.appdata</code> \u30b9\u30b3\u30fc\u30d7\uff09 \u3092\u4f7f\u3044\u307e\u3059\u3002\u3053\u306e\u9818\u57df\u306f\u5f53\u8a72\u30a2\u30d7\u30ea\u3060\u3051\u304c \u8aad\u307f\u66f8\u304d\u3067\u304d\u3001Google Drive \u306e\u901a\u5e38\u306e\u753b\u9762\u306b\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002</p> <ul> <li>\u8535\u66f8\u30fb\u8cb8\u51fa\u3057\u30fb\u56f3\u66f8\u9928\u8a2d\u5b9a\u306a\u3069\u306e\u30a2\u30d7\u30ea\u30c7\u30fc\u30bf\uff08\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306e\u5b9f\u4f53\uff09</li> <li>\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u540c\u4e00\u6027\u78ba\u8a8d\u306e\u305f\u3081\u306e\u6700\u5c0f\u9650\u306e\u60c5\u5831\uff08\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u30fb\u30a2\u30ab\u30a6\u30f3\u30c8\u8b58\u5225\u5b50\u3002   <code>about.get</code> \u3067\u53d6\u5f97\u3057\u3001\u540c\u671f\u5148\u304c\u6b63\u3057\u3044 Google \u30a2\u30ab\u30a6\u30f3\u30c8\u304b\u3069\u3046\u304b\u306e\u7a81\u304d\u5408\u308f\u305b\u306b\u306e\u307f   \u4f7f\u3046\u3002\u958b\u767a\u8005\u30b5\u30fc\u30d0\u30fc\u3078\u306f\u9001\u4fe1\u3057\u306a\u3044\uff09</li> </ul> <p>Google Tasks\u30fbGmail\u30fb\u30ab\u30ec\u30f3\u30c0\u30fc\u7b49\u3001\u4ed6\u306e Google \u30b5\u30fc\u30d3\u30b9\u306e\u30c7\u30fc\u30bf\u306b\u306f\u4e00\u5207\u30a2\u30af\u30bb\u30b9 \u3057\u307e\u305b\u3093\u3002</p>"},{"location":"privacy/#2-2","title":"2-2. \u7aef\u672b\u5185\u3067\u751f\u6210\u30fb\u4fdd\u5b58\u3055\u308c\u308b\u30c7\u30fc\u30bf","text":"<ul> <li>\u8535\u66f8\u30fb\u8cb8\u51fa\u3057\u8a18\u9332\u30fb\u30ec\u30d3\u30e5\u30fc\u30fb\u56f3\u66f8\u9928\u8a2d\u5b9a\u306a\u3069\u306e\u30a2\u30d7\u30ea\u30c7\u30fc\u30bf\uff08\u7aef\u672b\u5185 SQLite\uff09</li> <li>\u30ed\u30b0\u30d5\u30a1\u30a4\u30eb\uff08\u52d5\u4f5c\u8a18\u9332\u3002\u30a2\u30d7\u30ea\u306e\u4e0d\u5177\u5408\u8abf\u67fb\u306e\u305f\u3081\u7aef\u672b\u5185\u306b\u306e\u307f\u4fdd\u5b58\uff09</li> </ul>"},{"location":"privacy/#2-3-api","title":"2-3. \u5916\u90e8\u306e\u516c\u958b API \u3078\u9001\u4fe1\u3059\u308b\u60c5\u5831\uff08\u66f8\u8a8c\u30fb\u8535\u66f8\u7167\u4f1a\uff09","text":"<p>\u66f8\u8a8c\u60c5\u5831\u30fb\u8535\u66f8\u72b6\u6cc1\u3092\u8abf\u3079\u308b\u969b\u3001\u5229\u7528\u8005\u306e\u7aef\u672b\u304b\u3089\u76f4\u63a5\u3001\u6b21\u306e\u5916\u90e8\u30b5\u30fc\u30d3\u30b9\u3078 ISBN \u3084 \u56f3\u66f8\u9928\u30b7\u30b9\u30c6\u30e0\u306e\u8b58\u5225\u5b50\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002\u958b\u767a\u8005\u306e\u30b5\u30fc\u30d0\u30fc\u3092\u7d4c\u7531\u3057\u307e\u305b\u3093\u3002</p> <ul> <li>openBD\uff08\u66f8\u8a8c\u60c5\u5831\u30fb\u66f8\u5f71\uff09</li> <li>\u30ab\u30fc\u30ea\u30eb\uff08\u56f3\u66f8\u9928\u306e\u8535\u66f8\u72b6\u6cc1\u30fb\u8cb8\u51fa\u72b6\u6cc1\uff09</li> </ul> <p>\u9001\u4fe1\u3055\u308c\u308b\u306e\u306f\u691c\u7d22\u5bfe\u8c61\u306e\u66f8\u8a8c\u8b58\u5225\u5b50\uff08ISBN \u7b49\uff09\u3084\u56f3\u66f8\u9928\u306e\u8b58\u5225\u5b50\u306e\u307f\u3067\u3001\u5229\u7528\u8005\u3092 \u7279\u5b9a\u3059\u308b\u60c5\u5831\u306f\u542b\u307f\u307e\u305b\u3093\u3002</p>"},{"location":"privacy/#2-4-karita","title":"2-4. \u30d6\u30e9\u30a6\u30b6\u62e1\u5f35\u6a5f\u80fd\u300ckarita \u306b\u9001\u308b\u300d","text":"<p>\u62e1\u5f35\u6a5f\u80fd\u306f\u30c4\u30fc\u30eb\u30d0\u30fc\u306e\u30a2\u30a4\u30b3\u30f3\u3092\u62bc\u3057\u305f\u6642\u70b9\u306e\u30a2\u30af\u30c6\u30a3\u30d6\u30bf\u30d6\u306e URL \uff08\u307e\u305f\u306f\u30ab\u30fc\u30ea\u30eb\u56f3\u66f8\u9928\u30da\u30fc\u30b8\u304b\u3089\u958b\u3044\u305f\u5834\u5408\u3001\u5229\u7528\u8005\u304c\u8a31\u53ef\u3057\u305f\u89aa\u30bf\u30d6\u306e URL\uff09\u3092\u8aad\u307f\u53d6\u308a\u3001 <code>karita://share?url=...</code> \u3092\u901a\u3058\u3066\u540c\u3058\u7aef\u672b\u4e0a\u306e karita \u30a2\u30d7\u30ea\u3078\u6e21\u3059\u3060\u3051\u3067\u3059\u3002\u5916\u90e8 \u30b5\u30fc\u30d0\u30fc\u3078\u306e\u9001\u4fe1\u306f\u884c\u308f\u305a\u3001\u62e1\u5f35\u6a5f\u80fd\u81ea\u4f53\u3082\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3057\u307e\u305b\u3093\u3002 \u8a73\u7d30\u306f\u62e1\u5f35\u6a5f\u80fd\u306e \u30bd\u30fc\u30b9\u5185\u306e\u8aac\u660e\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"privacy/#3","title":"3. \u5229\u7528\u76ee\u7684","text":"<ul> <li>\u8535\u66f8\u30fb\u8cb8\u51fa\u3057\u72b6\u6cc1\u306e\u7ba1\u7406\u3068\u3001\u8907\u6570\u7aef\u672b\u9593\u3067\u306e\u540c\u671f</li> <li>\u66f8\u8a8c\u60c5\u5831\u30fb\u66f8\u5f71\u30fb\u56f3\u66f8\u9928\u306e\u8535\u66f8\u72b6\u6cc1\u306e\u8868\u793a</li> <li>\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u53d6\u308a\u9055\u3048\uff08\u8aa4\u3063\u305f Google \u30a2\u30ab\u30a6\u30f3\u30c8\u3078\u306e\u540c\u671f\uff09\u306e\u691c\u51fa</li> <li>\u30d6\u30e9\u30a6\u30b6\u304b\u3089\u30ab\u30fc\u30ea\u30eb\u306e\u66f8\u7c4d\u30da\u30fc\u30b8\u3092 karita \u3078\u5f15\u304d\u6e21\u3059\u64cd\u4f5c\u306e\u6a4b\u6e21\u3057</li> </ul>"},{"location":"privacy/#4","title":"4. \u30c7\u30fc\u30bf\u306e\u4fdd\u5b58\u306b\u3064\u3044\u3066","text":"<ul> <li>\u672c\u30a2\u30d7\u30ea\u306f \u72ec\u81ea\u30b5\u30fc\u30d0\u30fc\u306b\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3057\u307e\u305b\u3093</li> <li>\u30a2\u30d7\u30ea\u30c7\u30fc\u30bf\u306f\u7aef\u672b\u5185\u3001\u304a\u3088\u3073\u5229\u7528\u8005\u81ea\u8eab\u306e Google Drive \u306e\u30a2\u30d7\u30ea\u5c02\u7528\u9818\u57df   \uff08<code>drive.appdata</code>\uff09\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u9818\u57df\u306f\u5229\u7528\u8005\u672c\u4eba\u306e Google \u30a2\u30ab\u30a6\u30f3\u30c8\u306e   \u30b9\u30c8\u30ec\u30fc\u30b8\u5bb9\u91cf\u3092\u4f7f\u7528\u3057\u3001\u958b\u767a\u8005\u304b\u3089\u306f\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u305b\u3093</li> <li>\u30ed\u30b0\u30d5\u30a1\u30a4\u30eb\u306f\u7aef\u672b\u5185\u306b\u306e\u307f\u4fdd\u5b58\u3055\u308c\u307e\u3059</li> </ul>"},{"location":"privacy/#5","title":"5. \u30c7\u30fc\u30bf\u5171\u6709\u30fb\u7b2c\u4e09\u8005\u63d0\u4f9b","text":"<ul> <li>\u958b\u767a\u8005\uff08\u53e4\u6fa4 \u5b9f\uff09\u3092\u542b\u3080\u7b2c\u4e09\u8005\u3078\u3001\u30a2\u30d7\u30ea\u306e\u5229\u7528\u8005\u30c7\u30fc\u30bf\u3092\u63d0\u4f9b\u30fb\u8ca9\u58f2\u3059\u308b\u3053\u3068\u306f   \u3042\u308a\u307e\u305b\u3093</li> <li>openBD\u30fb\u30ab\u30fc\u30ea\u30eb\u3068\u306e\u901a\u4fe1\u306f\u3001\u5229\u7528\u8005\u306e\u7aef\u672b\u3068\u305d\u308c\u305e\u308c\u306e\u30b5\u30fc\u30d3\u30b9\u304c\u76f4\u63a5\u884c\u3044\u307e\u3059   \uff08\u958b\u767a\u8005\u30b5\u30fc\u30d0\u30fc\u3092\u4e2d\u7d99\u3057\u307e\u305b\u3093\uff09</li> <li>\u5e83\u544a\u4f1a\u793e\u30fb\u5206\u6790\u4e8b\u696d\u8005\u3078\u306e\u81ea\u52d5\u5171\u6709\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u672c\u30a2\u30d7\u30ea\u306b\u5e83\u544a\u30fb\u30a2\u30af\u30bb\u30b9\u89e3\u6790\u306e   \u6a5f\u80fd\u306f\u3042\u308a\u307e\u305b\u3093</li> </ul>"},{"location":"privacy/#6","title":"6. \u30e6\u30fc\u30b6\u30fc\u306b\u3088\u308b\u5236\u5fa1\u65b9\u6cd5","text":"<ul> <li>Google \u30a2\u30ab\u30a6\u30f3\u30c8\u3068\u306e\u9023\u643a\u89e3\u9664\u306f   Google \u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u30a2\u30af\u30bb\u30b9\u8a31\u53ef\u30da\u30fc\u30b8   \u304b\u3089\u884c\u3048\u307e\u3059\u3002\u89e3\u9664\u3059\u308b\u3068 <code>drive.appdata</code> \u9818\u57df\u3078\u306e\u540c\u671f\u306f\u884c\u308f\u308c\u306a\u304f\u306a\u308a\u307e\u3059   \uff08\u65e2\u5b58\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u81ea\u4f53\u306f Google \u5074\u306e\u8a2d\u5b9a\u306b\u5f93\u3044\u307e\u3059\uff09</li> <li>\u30a2\u30d7\u30ea\u5185\u306e\u64cd\u4f5c\u3067\u30b5\u30a4\u30f3\u30a2\u30a6\u30c8\u3067\u304d\u307e\u3059\uff08Windows\uff09\u3002Android \u306f Google \u306e\u30b5\u30a4\u30f3\u30a4\u30f3   \u72b6\u614b\u304c\u305d\u306e\u307e\u307e\u5229\u7528\u3055\u308c\u307e\u3059</li> <li>\u7aef\u672b\u5185\u306e\u30c7\u30fc\u30bf\uff08\u8535\u66f8\u30fb\u8cb8\u51fa\u3057\u8a18\u9332\u30fb\u30ed\u30b0\u7b49\uff09\u306f\u3001\u30a2\u30d7\u30ea\u306e\u